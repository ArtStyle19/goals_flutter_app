# ============================================
# Productivity Planner - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ============================================

# API Configuration
API_BASE_URL=http://your-api-url.com/api

# Timeout Configuration (in seconds)
API_CONNECT_TIMEOUT_SECONDS=30
API_RECEIVE_TIMEOUT_SECONDS=30
GOAL_CREATE_TIMEOUT_SECONDS=90

# Feature Flags
ENABLE_LOGGING=true

# App Configuration
APP_NAME=Productivity Planner
